@startuml
!include ../C4-PlantUML-2.11.0/C4_Component.puml

LAYOUT_WITH_LEGEND()

title [Component] Микросервис «Devices»

Container(api_gateway, "API Gateway", "Kusk", "Распределяет запросы между микросервисами и их инстансами")
ContainerDb(database_common, "Database", "PostgreSQL", "Хранит информацию")

Container_Boundary(api_devices, "API Devices") {
  Component(device_settings, "Controller 'Device settings'", "Установка дефолтных настроек устройствам")
}

Rel(api_gateway, device_settings, "Uses", "JSON/HTTPS")

Rel(device_settings, database_common, "Uses", "JSON/HTTPS")
@enduml